
BEGIN CentralBody

    Name            Uranus

    Prefix          Planeto

    ShortDescription            Planet Uranus

    Description         Planet Uranus

    Type            Planet

    FuncCbInit      UranusInit
    FuncCbFree      PlanetFree
    FuncCbLoad      PlanetLoad
    FuncCbSave      PlanetSave
    FuncCbCopy      PlanetCopy
    FuncCbSet      PlanetSet

BEGIN          AstroDefinition

# value from ura083Spice.grv
	  Gm 				  5.793965663939276e+015

# Gm for planet Uranus, from http://ssd.jpl.nasa.gov/sat_gravity.html
#	  Gm                  5.793939e+015
	        
# Gm for the Uranus system from DE405 file 
#	  SystemGm			  5.794549007072e+015

# Gm for the Uranus system from ura083.bsp file 
	  SystemGm			  5.794557628118015e+015
	        
# Gm for the Uranus system from http://ssd.jpl.nasa.gov/sat_gravity.html
#	  SystemGm			  5.794549e+015

#
# Shape values are from "Report of the IAU/IAG Working Group on Cartographic Coordinates
# and Rotational Elements: 2006", Celestial Mechanics Dyn Astry 98: 155-180, 2007.
#

      GravityModel		  ura083Spice

      Shape      	      OblateSpheroid
      MajorAxis           2.55590000000000e+007
      MinorAxis           2.49730000000000e+007
      
      MaxAltitude         0.00000000000000e+000

# As of STK v11.2, RefDistance is established from the GravityModel      
# and MinRadius is determined from Shape parameters. Uncomment lines
# below to for STK versions prior to v11.2.
#     RefDistance         2.55590000000000e+007
#     MinRadius           2.49730000000000e+007

      ParentName          Sun

      PathGenerator GreatArc
      PathGenerator J2Perturbation
      PathGenerator J4Perturbation
      PathGenerator Rocket
      PathGenerator TwoBody
      PathGenerator StkExternal
      PathGenerator Astrogator
      PathGenerator SPICE
      PathGenerator HoldCBIPosition
      PathGenerator HoldCBFPosition
      PathGenerator HPOP

END          AstroDefinition

BEGIN		SpinData

	RotationDefinitionFile		UranusAttitude2000.rot
	
END 			SpinData

BEGIN               EphemerisData

# NOTE: currently the ephemeris source is set to use JPL SPICE files
#		which can locate the barycenter or the planet center depending on the JplSpiceId
#
#		The JPL DE file only contains the barycenter
#
#		To instead use JPL DE file, uncomment out the following line and comment the JplSpice line
	
#	EphemerisSource              JplDE
	EphemerisSource              JplSpice
	
# NOTE: if you are using SPICE, you may choose to use the planet center (799) or barycenter (7)
	
	JplSpiceId                   799
#	JplSpiceId                   7


END					EphemerisData

BEGIN	Uranus

END     Uranus

    ReadOnly            Yes

END CentralBody

#
# From "Report of the IAU/IAG Working Group on Cartographic Coordinates and
# Rotational Elements of the Planets and satellites: 2006", 
# Celestial Mechanics 98: 155-180, 2007.
#
# The spin rate has been updated over the IAU 2000 model so that it is correct
# for the time when light leaves the sun, not arrives at the Earth as it was before.
#

BEGIN RotationalData

	ModelName	IAU 2006
	
	Description	Coefficients from the IAU 2006 parameter set

	RotationEpoch	2451545.0

	Begin RotationalElement
	Type			SpinAxisRightAscension
	Constant		286.13
	Rate			0.0
	RateDot		 	0.0
	NumberOfTerms		0
	End RotationalElement

	Begin RotationalElement
	Type			SpinAxisDeclination
	Constant		63.87
	Rate			0.0
	RateDot		 	0.0
	NumberOfTerms		0
	End RotationalElement

	Begin RotationalElement
	Type			Rotation
	Constant		84.176 
	Rate			14.1844000  
	RateDot		   	0.0
	NumberOfTerms	   	0
	End RotationalElement

END RotationalData

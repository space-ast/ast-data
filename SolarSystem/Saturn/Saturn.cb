
BEGIN CentralBody

    Name            Saturn
    
	FuncCbInit      SaturnInit
	FuncCbFree      PlanetFree
	FuncCbLoad      PlanetLoad
	FuncCbSave      PlanetSave
	FuncCbCopy      PlanetCopy
	FuncCbSet       PlanetSet

    Prefix          Planeto

    ShortDescription    Planet Saturn
    Description         Planet Saturn

    Type            Planet

BEGIN          AstroDefinition

      
# Gm for planet Saturn, from Astron2004.grv
	 Gm                   3.7931284e+016
	        
# Gm for the Saturnian system from DE405 file
#	 SystemGm			  3.794062606114e+016
	 
# Gm for the Saturnian system from sat252s.bsp file 
	 SystemGm			  3.794058536167639e+016
	        
# Gm for the Saturnian system from http://ssd.jpl.nasa.gov/sat_gravity.html
#	  SystemGm			  3.7940672e+016

#
# Shape values are from "Report of the IAU/IAG Working Group on Cartographic Coordinates
# and Rotational Elements: 2006", Celestial Mechanics Dyn Astry 98: 155-180, 2007.
#

      GravityModel		  Astron2004
      
# To reset the values to those used previous to STK 6.2,
# uncomment the following lines
#	  Gm				  3.7934e+016
#	  GravityModel		  ZonalsToJ4

      Shape      	 OblateSpheroid
      MajorAxis      6.02680000000000e+007
      MinorAxis      5.43640000000000e+007

      MaxAltitude         0.00000000000000e+000

# As of STK v11.2, RefDistance is established from the GravityModel      
# and MinRadius is determined from Shape parameters. Uncomment lines
# below to for STK versions prior to v11.2.
#     RefDistance         6.02680000000000e+007
#     MinRadius           5.43640000000000e+007

      ParentName          Sun

      PathGenerator GreatArc
      PathGenerator J2Perturbation
      PathGenerator J4Perturbation
      PathGenerator Rocket
      PathGenerator TwoBody
      PathGenerator StkExternal
      PathGenerator Astrogator
      PathGenerator SPICE
      PathGenerator HoldCBIPosition
      PathGenerator HoldCBFPosition
      PathGenerator SimpleAscent
      PathGenerator HPOP


END          AstroDefinition

BEGIN		SpinData

	RotationDefinitionFile		SaturnAttitude2000.rot
	
END 			SpinData

BEGIN               EphemerisData

# NOTE: currently the ephemeris source is set to use JPL SPICE files
#		which can locate the barycenter or the planet center depending on the JplSpiceId
#
#		The JPL DE file only contains the barycenter
#
#		To instead use JPL DE file, uncomment out the following line and comment the JplSpice line

#	EphemerisSource              JplDE
	EphemerisSource              JplSpice

# NOTE: if you are using SPICE, you may choose to use the planet center (699) or barycenter (6)

	JplSpiceId                   699
#	JplSpiceId                   6


END					EphemerisData

BEGIN	Saturn

END     Saturn

    ReadOnly            Yes

END CentralBody

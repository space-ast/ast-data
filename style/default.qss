/* ============================================================================
   SpaceAST 主界面样式表
   ============================================================================ */

QMainWindow {
    background-color: #3c3c3c;
}

/* ---- 顶部 Ribbon 页签 ---- */

#RibbonTabBar {
    background-color: #1a5c9e;
}

#RibbonTabBar::tab {
    background-color: #1a5c9e;
    color: #c0d8f0;
    padding: 6px 16px;
    border: none;
    border-right: 1px solid #3a7abf;
    min-width: 60px;
}

#RibbonTabBar::tab:selected {
    background-color: #eef3f8;
    color: #1a5c9e;
    font-weight: bold;
}

#RibbonTabBar::tab:hover:!selected {
    background-color: #2570bf;
}

/* ---- Ribbon 工具页 ---- */

#RibbonStack {
    background-color: #eef3f8;
    min-height: 60px;
    max-height: 60px;
}

#RibbonStack QToolButton {
    border: none;
    background: transparent;
    color: #333;
    padding: 4px 6px;
    font-size: 11px;
}

#RibbonStack QToolButton:hover {
    background-color: #d0dff0;
    border: 1px solid #a0b8d0;
    border-radius: 2px;
}

#RibbonStack QToolButton:pressed {
    background-color: #bdd0e8;
}

/* ---- 时间控制条 ---- */

#TimeControlBar {
    background-color: #eef3f8;
    border-top: 1px solid #c8d8e8;
    min-height: 28px;
}

#TimeControlBar QToolButton {
    border: none;
    background: transparent;
    padding: 2px;
}

#TimeControlBar QToolButton:hover {
    background-color: #d0dff0;
    border-radius: 2px;
}

/* ---- 中央画布 ---- */

#CentralCanvas {
    background-color: #8f9499;
    border: none;
}

/* ---- 停靠面板 ---- */

QDockWidget {
    font-size: 12px;
}

/* ---- 状态栏 ---- */

QStatusBar {
    background-color: #e8e8e8;
    border-top: 1px solid #c0c0c0;
    font-size: 11px;
}

QStatusBar QLabel {
    padding: 1px 8px;
    border: 1px solid #c0c0c0;
    border-radius: 1px;
    background: #f5f5f5;
    margin: 1px 2px;
}

/* ---- 起始页 ---- */

#StartPage {
    background: #ffffff;
}

#StartPageSidebar {
    background: #f4f4f4;
    border-right: 1px solid #e1e1e1;
    color: #1f1f1f;
    font-size: 12px;
}

#StartPageLogo {
    color: #2086d7;
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 27px;
    font-weight: 400;
    letter-spacing: 0.4px;
}

#StartPageSubtitle {
    color: #6f6f6f;
    font-size: 12px;
    font-weight: 400;
}

#StartPageSectionTitle {
    color: #171717;
    font-size: 15px;
    font-weight: 700;
    padding-top: 2px;
    padding-bottom: 3px;
}

#StartPageActionButton {
    border: none;
    border-radius: 2px;
    padding: 3px 4px;
    min-height: 22px;
    text-align: left;
    color: #222222;
    font-size: 12px;
    font-weight: 400;
}

#StartPageActionButton:hover {
    background: #e8edf4;
}

#StartPageLinkButton {
    border: none;
    border-radius: 2px;
    padding: 2px 4px;
    min-height: 20px;
    text-align: left;
    color: #222222;
    font-size: 12px;
    font-weight: 400;
}

#StartPageLinkButton:hover {
    background: #e8edf4;
}

#StartPageStartupCheck {
    color: #303030;
    font-size: 12px;
    font-weight: 400;
    spacing: 6px;
}

#StartPageMainArea {
    background: #ffffff;
}

#StartPageTabWidget::pane {
    border: none;
    border-top: 1px solid #e3e7ed;
}

#StartPageTabWidget QTabBar::tab {
    background: #eef1f5;
    border: 1px solid #d8dde5;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 7px 22px;
    margin-right: 6px;
}

#StartPageTabWidget QTabBar::tab:selected {
    background: #ffffff;
    color: #1b73c9;
    font-weight: 600;
}

#StartPageCard {
    background: #fbfcfe;
    border: 1px solid #e0e5ec;
    border-radius: 3px;
    padding: 10px;
    color: #1f2d3d;
}

#StartPageCard:hover {
    background: #f2f7ff;
    border-color: #9ec7f2;
}

#StartPageCard:pressed {
    background: #e7f1ff;
}

/* ============================================================================
   SpaceAST 主界面样式表
   ============================================================================ */

QMainWindow {
    background-color: #3c3c3c;
}

/* ---- 顶部 Ribbon 页签 ---- */

#RibbonTabBar {
    background-color: #1a5c9e;
}

#RibbonTabBar::tab {
    background-color: #1a5c9e;
    color: #c0d8f0;
    padding: 6px 16px;
    border: none;
    border-right: 1px solid #3a7abf;
    min-width: 60px;
}

#RibbonTabBar::tab:selected {
    background-color: #eef3f8;
    color: #1a5c9e;
    font-weight: bold;
}

#RibbonTabBar::tab:hover:!selected {
    background-color: #2570bf;
}

/* ---- Ribbon 工具页 ---- */

#RibbonStack {
    background-color: #eef3f8;
    min-height: 60px;
    max-height: 60px;
}

#RibbonStack QToolButton {
    border: none;
    background: transparent;
    color: #333;
    padding: 4px 6px;
    font-size: 11px;
}

#RibbonStack QToolButton:hover {
    background-color: #d0dff0;
    border: 1px solid #a0b8d0;
    border-radius: 2px;
}

#RibbonStack QToolButton:pressed {
    background-color: #bdd0e8;
}

/* ---- 时间控制条 ---- */

#TimeControlBar {
    background-color: #eef3f8;
    border-top: 1px solid #c8d8e8;
    min-height: 28px;
}

#TimeControlBar QToolButton {
    border: none;
    background: transparent;
    padding: 2px;
}

#TimeControlBar QToolButton:hover {
    background-color: #d0dff0;
    border-radius: 2px;
}

/* ---- 中央画布 ---- */

#CentralCanvas {
    background-color: #8f9499;
    border: none;
}

/* ---- 停靠面板 ---- */

QDockWidget {
    font-size: 12px;
}

/* ---- 状态栏 ---- */

QStatusBar {
    background-color: #e8e8e8;
    border-top: 1px solid #c0c0c0;
    font-size: 11px;
}

QStatusBar QLabel {
    padding: 1px 8px;
    border: 1px solid #c0c0c0;
    border-radius: 1px;
    background: #f5f5f5;
    margin: 1px 2px;
}

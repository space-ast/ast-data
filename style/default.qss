/* ============================================================================
   SpaceAST 主界面样式表
   ============================================================================ */

QMainWindow {
    background-color: #f1f1f1;
    color: #202020;
    font-family: "Microsoft YaHei UI", "Segoe UI", "Noto Sans SC";
    font-size: 12px;
}

/* ---- 顶部 Ribbon 页签 ---- */

#RibbonWidget {
    background-color: #e9e9e9;
}

#RibbonTabBar {
    background-color: #e3e3e3;
    border-bottom: 1px solid #cfcfcf;
}

#RibbonTabBar::tab {
    background-color: transparent;
    color: #1f1f1f;
    padding: 5px 12px;
    border: none;
    min-width: 44px;
}

#RibbonTabBar::tab:selected {
    background-color: #ffffff;
    color: #2678c9;
    border-left: 1px solid #d4d4d4;
    border-right: 1px solid #d4d4d4;
    border-top: 2px solid #4d9be8;
    padding-top: 3px;
}

#RibbonTabBar::tab:hover:!selected {
    background-color: #eeeeee;
}

/* ---- Ribbon 工具页 ---- */

#RibbonStack {
    background-color: #f7f7f7;
    border-bottom: 1px solid #d6d6d6;
    min-height: 64px;
    max-height: 64px;
}

#RibbonStack QToolButton {
    border: 1px solid transparent;
    background: transparent;
    color: #282828;
    padding: 3px 6px;
    font-size: 11px;
    min-height: 48px;
}

#RibbonStack QToolButton:hover {
    background-color: #edf5ff;
    border: 1px solid #b8d6f2;
    border-radius: 2px;
}

#RibbonStack QToolButton:pressed,
#RibbonStack QToolButton:checked {
    background-color: #dcecff;
    border: 1px solid #8fc0ef;
}

#RibbonStack QFrame[frameShape="5"] {
    color: #d4d4d4;
}

/* ---- 时间控制条 ---- */

#TimeControlBar {
    background-color: #f7f7f7;
    border-top: 1px solid #e0e0e0;
    border-bottom: 1px solid #d6d6d6;
    min-height: 24px;
}

#TimeControlBar QLabel {
    color: #3d3d3d;
    font-size: 11px;
}

#TimeControlBar QToolButton {
    border: 1px solid transparent;
    background: transparent;
    padding: 1px;
}

#TimeControlBar QToolButton:hover {
    background-color: #e8f2ff;
    border: 1px solid #b8d6f2;
    border-radius: 2px;
}

/* ---- 中央画布 ---- */

#CentralCanvas {
    background-color: #ffffff;
    border: none;
}

/* ---- 停靠面板 ---- */

QDockWidget {
    background: #f6f6f6;
    border: 1px solid #cfcfcf;
    font-size: 12px;
}

QDockWidget::title {
    background: #efefef;
    border-bottom: 1px solid #d4d4d4;
    padding: 4px 6px;
    text-align: left;
}

QDockWidget QWidget {
    background: #ffffff;
}

QDockWidget QToolButton {
    border: 1px solid transparent;
    background: transparent;
    padding: 1px;
}

QDockWidget QToolButton:hover {
    background: #edf5ff;
    border: 1px solid #b8d6f2;
    border-radius: 2px;
}

QTabWidget::pane {
    border: 1px solid #d9d9d9;
    top: -1px;
}

QTabBar::tab {
    background: #efefef;
    border: 1px solid #d9d9d9;
    padding: 4px 10px;
    margin-right: 1px;
}

QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: #ffffff;
    color: #2678c9;
}

QTreeView,
QTreeWidget {
    background: #ffffff;
    alternate-background-color: #f7f7f7;
    border: none;
    color: #242424;
    show-decoration-selected: 1;
}

QTreeView::item,
QTreeWidget::item {
    min-height: 20px;
    padding: 1px 2px;
}

QTreeView::item:selected,
QTreeWidget::item:selected {
    background: #dcecff;
    color: #111111;
}

/* ---- 状态栏 ---- */

QStatusBar {
    background-color: #2f86d8;
    border-top: 1px solid #1f6eb7;
    color: #ffffff;
    font-size: 11px;
}

QStatusBar QLabel {
    padding: 1px 8px;
    border: none;
    color: #ffffff;
    background: transparent;
    margin: 0 1px;
}

/* ---- 起始页 ---- */

#StartPage {
    background: #ffffff;
}

#StartPageSidebar {
    background: #f3f3f3;
    border-right: 1px solid #dddddd;
    color: #1f1f1f;
    font-size: 12px;
}

#StartPageLogo {
    color: #2489d8;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Noto Sans SC";
    font-size: 25px;
    font-weight: 400;
    letter-spacing: 0.3px;
}

#StartPageSubtitle {
    color: #6a6a6a;
    font-size: 12px;
    font-weight: 400;
}

#StartPageSectionTitle {
    color: #151515;
    font-size: 13px;
    font-weight: 700;
    padding-top: 2px;
    padding-bottom: 4px;
}

#StartPageActionButton {
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 3px 4px;
    min-height: 22px;
    text-align: left;
    color: #222222;
    background: transparent;
    font-size: 12px;
    font-weight: 400;
}

#StartPageActionButton:hover {
    background: #e8f2ff;
    border-color: #c6def4;
}

#StartPageLinkButton {
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px 4px;
    min-height: 20px;
    text-align: left;
    color: #222222;
    background: transparent;
    font-size: 12px;
    font-weight: 400;
}

#StartPageLinkButton:hover {
    background: #e8f2ff;
    border-color: #c6def4;
}

#StartPageStartupCheck {
    color: #303030;
    font-size: 12px;
    font-weight: 400;
    spacing: 6px;
}

#StartPageMainArea {
    background: #ffffff;
}

#StartPageMainArea QScrollArea,
#StartPageMainArea QScrollArea QWidget {
    background: #ffffff;
}

#StartPageTabWidget::pane {
    border: none;
    border-top: 1px solid #e5e5e5;
    top: -1px;
}

#StartPageTabWidget QTabBar::tab {
    background: #f0f0f0;
    border: 1px solid #dddddd;
    border-bottom: none;
    padding: 6px 26px;
    margin-right: 2px;
    min-width: 42px;
}

#StartPageTabWidget QTabBar::tab:selected {
    background: #ffffff;
    color: #2678c9;
    font-weight: 600;
}

#StartPageCard {
    background: #ffffff;
    border: 1px solid #e5e9ef;
    border-radius: 1px;
    padding: 8px 4px 5px 4px;
    color: #111111;
    font-weight: 600;
    text-align: left;
}

#StartPageCard:hover {
    background: #f7fbff;
    border-color: #bcd8f2;
}

#StartPageCard:pressed {
    background: #edf5ff;
    border-color: #8fc0ef;
}

/* ---- 新建对象对话框 ---- */

#NewObjectDescLabel {
    color: #555555;
    padding: 6px 8px;
    background: #f2f2f2;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
    font-size: 12px;
}
